.spring-boot-devtools.properties

# ==========================================
# Databases / JDBC / Hibernate / JPA
# ==========================================
# Ignore embedded database files (like H2 or Derby) generated during runtime
*.mv.db
*.trace.db
*.h2.db
data/
db/

# Hibernate/JPA schema generation outputs or caches
.ehcache/
hibernate.log

